  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    },
    "schemas": {
      "Customer": {
        "type": "object",
        "properties": {
          "phoneNumber": {
            "type": "string",
            "description": "Phone number in E.164 format (e.g. +2250700000000)"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["phoneNumber"]
      },
      "Recipient": {
        "type": "object",
        "properties": {
          "phoneNumber": {
            "type": "string",
            "description": "Recipient phone number in E.164 format"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["phoneNumber"]
      },
      "PaymentInitiateRequest": {
        "type": "object",
        "properties": {
          "merchantReference": {
            "type": "string",
            "description": "Merchant reference (unique)"
          },
          "amount": {
            "type": "number",
            "minimum": 1
          },
          "currency": {
            "type": "string",
            "example": "XOF"
          },
          "channel": {
            "type": "string",
            "example": "mtn_momo"
          },
          "country": {
            "type": "string",
            "example": "CI"
          },
          "customer": {
            "$ref": "#/components/schemas/Customer"
          },
          "description": {
            "type": "string"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          },
          "workflow": {
            "type": "string",
            "enum": ["otp", "in_app"],
            "description": "Payment workflow"
          },
          "otp": {
            "type": "string",
            "nullable": true,
            "description": "OTP value (required when workflow=otp and submitting OTP)"
          },
          "successRedirectUrl": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
