    "/payments/initiate": {
      "post": {
        "tags": ["Payments"],
        "summary": "Initiate Payment",
        "description": "Initiate a payment (OTP or in_app workflow).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentInitiateRequest"
              },
              "examples": {
                "otp": {
                  "summary": "OTP workflow",
                  "value": {
                    "merchantReference": "order-123",
                    "amount": 5000,
                    "currency": "XOF",
                    "channel": "mtn_momo",
                    "country": "CI",
                    "customer": {
                      "phoneNumber": "+2250700000000",
                      "email": "customer@example.com",
                      "name": "John Doe"
                    },
                    "workflow": "otp",
                    "description": "Payment for order #123",
                    "metadata": {
                      "orderId": "123"
                    },
                    "otp": ""
                  }
                },
                "in_app": {
                  "summary": "In-app workflow",
                  "value": {
                    "merchantReference": "order-124",
                    "amount": 5000,
                    "currency": "XOF",
                    "channel": "wave",
                    "country": "CI",
                    "customer": {
                      "phoneNumber": "+2250700000000",
                      "email": "customer@example.com",
                      "name": "John Doe"
                    },
                    "workflow": "in_app",
                    "successRedirectUrl": "https://myapp.com/payment/success",
                    "failedRedirectUrl": "https://myapp.com/payment/failed",
                    "description": "Payment for order #124",
                    "metadata": {
                      "orderId": "124"
                    }
                  }
                },
                "no_workflow": {
                  "summary": "No workflow (legacy)",
                  "value": {
                    "merchantReference": "order-125",
                    "amount": 5000,
                    "currency": "XOF",
                    "channel": "orange_money",
                    "country": "CI",
                    "customer": {
                      "phoneNumber": "+2250700000000",
                      "email": "customer@example.com",
                      "name": "John Doe"
                    },
                    "description": "Payment for order #125",
                    "metadata": {
                      "orderId": "125"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Payment initiated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "transactionId": {
                      "type": "string"
                    },
                    "reference": {
                      "type": "string"
                    },
                    "merchantReference": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "amount": {
                      "type": "number"
                    },
                    "currency": {
                      "type": "string"
                    },
                    "environment": {
                      "type": "string"
                    },
                    "partner": {
                      "type": "string"
                    },
                    "partnerTransactionId": {
                      "type": "string"
                    },
                    "validationData": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized - Invalid API Key"
          },
          "500": {
            "description": "Server Error"
          }
        }
      }
    },
