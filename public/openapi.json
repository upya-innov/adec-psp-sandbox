{
  "openapi": "3.0.3",
  "info": {
    "title": "Payment Processor API",
    "version": "1.0.0",
    "description": "Complete API for the Payment Processor platform supporting payments, transfers, and multi-tenant management"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    }
  ],
  "tags": [
    { "name": "Payments" },
    { "name": "Transfers" },
    { "name": "Countries" },
    { "name": "Channels" },
    { "name": "Currencies" },
    { "name": "Partners" }
  ],
  "paths": {
    "/payments/initiate": {
      "post": {
        "tags": ["Payments"],
        "summary": "Initiate Payment (API Key)",
        "description": "Initiate a payment using API Key authentication",
        "security": [{ "apiKeyAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "transaction_id": { 
                    "type": "string",
                    "description": "Unique identifier for the transaction (max 50 characters)"
                  },
                  "amount": { 
                    "type": "number",
                    "minimum": 1,
                    "description": "Amount to be paid"
                  },
                  "currency": { 
                    "type": "string",
                    "description": "Currency code (e.g., XOF, EUR, USD)"
                  },
                  "country": { 
                    "type": "string",
                    "description": "Country code (e.g., CI, SN, ML)"
                  },
                  "channel": { 
                    "type": "string",
                    "description": "Payment channel (e.g., orange_money, mtn_momo, wave)"
                  },
                  "customer": {
                    "type": "object",
                    "properties": {
                      "phone_number": { 
                        "type": "string",
                        "description": "Customer's phone number (required for mobile money)"
                      },
                      "email": { 
                        "type": "string", 
                        "format": "email",
                        "description": "Customer's email address"
                      },
                      "name": { 
                        "type": "string",
                        "description": "Customer's full name"
                      }
                    },
                    "required": ["phone_number"]
                  },
                  "description": { 
                    "type": "string",
                    "description": "Description of the payment"
                  },
                  "metadata": {
                    "type": "object",
                    "additionalProperties": true,
                    "description": "Additional metadata for the payment"
                  },
                  "callback_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "URL to receive payment status updates via webhook"
                  }
                },
                "required": ["transaction_id", "amount", "currency", "country", "channel", "customer"]
              },
              "example": {
                "transaction_id": "TX-1705234567890",
                "amount": 1000,
                "currency": "XOF",
                "country": "CI",
                "channel": "orange_money",
                "customer": {
                  "phone_number": "2250700000000",
                  "email": "customer@example.com",
                  "name": "John Doe"
                },
                "description": "Payment for order #12345",
                "metadata": {
                  "order_id": "12345",
                  "product": "Premium Subscription"
                },
                "callback_url": "https://webhook.example.com/payments"
              }
            }
          }
        },
        "responses": {
          "201": { 
            "description": "Payment initiated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "transaction_id": { "type": "string" },
                    "status": { "type": "string" },
                    "amount": { "type": "number" },
                    "currency": { "type": "string" },
                    "payment_url": { "type": "string", "format": "uri" },
                    "expires_at": { "type": "string", "format": "date-time" },
                    "created_at": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          },
          "400": { "description": "Bad Request" },
          "401": { "description": "Unauthorized - Invalid API Key" },
          "500": { "description": "Server Error" }
        }
      }
    },
     "/payments": {
      "get": {
        "tags": ["Payments"],
        "summary": "Query Payments",
        "description": "Retrieve payments with filtering options using API Key authentication",
        "security": [{ "apiKeyAuth": [] }],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Filter by payment status (e.g., pending, completed, failed, cancelled)"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { 
              "type": "integer",
              "default": 50,
              "maximum": 100
            },
            "description": "Maximum number of payments to return"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": { 
              "type": "integer",
              "default": 0,
              "minimum": 0
            },
            "description": "Number of payments to skip"
          },
          {
            "name": "start_date",
            "in": "query",
            "required": false,
            "schema": { 
              "type": "string",
              "format": "date"
            },
            "description": "Filter payments created on or after this date (YYYY-MM-DD)"
          },
          {
            "name": "end_date",
            "in": "query",
            "required": false,
            "schema": { 
              "type": "string",
              "format": "date"
            },
            "description": "Filter payments created on or before this date (YYYY-MM-DD)"
          },
          {
            "name": "transaction_id",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Filter by specific transaction ID"
          },
          {
            "name": "customer_phone",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Filter by customer phone number"
          },
          {
            "name": "customer_email",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Filter by customer email"
          },
          {
            "name": "amount_min",
            "in": "query",
            "required": false,
            "schema": { "type": "number" },
            "description": "Filter by minimum amount"
          },
          {
            "name": "amount_max",
            "in": "query",
            "required": false,
            "schema": { "type": "number" },
            "description": "Filter by maximum amount"
          }
        ],
        "responses": {
          "200": { 
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "transaction_id": { "type": "string" },
                          "amount": { "type": "number" },
                          "currency": { "type": "string" },
                          "status": { "type": "string" },
                          "created_at": { "type": "string", "format": "date-time" },
                          "customer": {
                            "type": "object",
                            "properties": {
                              "phone_number": { "type": "string" },
                              "email": { "type": "string" },
                              "name": { "type": "string" }
                            }
                          }
                        }
                      }
                    },
                    "pagination": {
                      "type": "object",
                      "properties": {
                        "total": { "type": "integer" },
                        "limit": { "type": "integer" },
                        "offset": { "type": "integer" },
                        "has_more": { "type": "boolean" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Bad Request" },
          "401": { "description": "Unauthorized - Invalid API Key" },
          "500": { "description": "Server Error" }
        }
      }
    },
    "/payments/{transactionId}": {
      "get": {
        "tags": ["Payments"],
        "summary": "Get Payment Status",
        "description": "Get payment status by transaction ID",
        "security": [{ "apiKeyAuth": [] }],
        "parameters": [
          {
            "name": "transactionId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Transaction ID of the payment"
          }
        ],
        "responses": {
          "200": { 
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "transaction_id": { "type": "string" },
                    "status": { "type": "string" },
                    "amount": { "type": "number" },
                    "currency": { "type": "string" },
                    "country": { "type": "string" },
                    "channel": { "type": "string" },
                    "customer": {
                      "type": "object",
                      "properties": {
                        "phone_number": { "type": "string" },
                        "email": { "type": "string" },
                        "name": { "type": "string" }
                      }
                    },
                    "description": { "type": "string" },
                    "metadata": {
                      "type": "object",
                      "additionalProperties": true
                    },
                    "created_at": { "type": "string", "format": "date-time" },
                    "updated_at": { "type": "string", "format": "date-time" },
                    "completed_at": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized - Invalid API Key" },
          "404": { "description": "Payment not found" },
          "500": { "description": "Server Error" }
        }
      }
    },
    "/payments/{transactionId}/cancel": {
      "patch": {
        "tags": ["Payments"],
        "summary": "Cancel Payment",
        "description": "Cancel a payment",
        "security": [{ "apiKeyAuth": [] }],
        "parameters": [
          {
            "name": "transactionId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Transaction ID of the payment to cancel"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reason": { 
                    "type": "string",
                    "description": "Reason for cancellation"
                  }
                },
                "required": ["reason"]
              },
              "example": {
                "reason": "Customer requested cancellation"
              }
            }
          }
        },
        "responses": {
          "200": { 
            "description": "Payment cancelled successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "transaction_id": { "type": "string" },
                    "status": { "type": "string" },
                    "cancelled_at": { "type": "string", "format": "date-time" },
                    "cancellation_reason": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "description": "Bad Request - Payment cannot be cancelled" },
          "401": { "description": "Unauthorized - Invalid API Key" },
          "404": { "description": "Payment not found" },
          "500": { "description": "Server Error" }
        }
      }
    },
    "/transfers/api-key": {
      "post": {
        "tags": ["Transfers"],
        "summary": "Initiate Transfer (API Key)",
        "description": "Initiate a transfer using API Key authentication",
        "security": [{ "apiKeyAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "transfer_id": { 
                    "type": "string",
                    "description": "Unique identifier for the transfer (max 50 characters)"
                  },
                  "amount": { 
                    "type": "number",
                    "minimum": 1,
                    "description": "Amount to be transferred"
                  },
                  "currency": { 
                    "type": "string",
                    "description": "Currency code (e.g., XOF, EUR, USD)"
                  },
                  "country": { 
                    "type": "string",
                    "description": "Country code (e.g., CI, SN, ML)"
                  },
                  "channel": { 
                    "type": "string",
                    "description": "Transfer channel (e.g., orange_money, mtn_momo, wave)"
                  },
                  "recipient": {
                    "type": "object",
                    "properties": {
                      "phone_number": { 
                        "type": "string",
                        "description": "Recipient's phone number (required for mobile money)"
                      },
                      "name": { 
                        "type": "string",
                        "description": "Recipient's full name"
                      }
                    },
                    "required": ["phone_number"]
                  },
                  "description": { 
                    "type": "string",
                    "description": "Description of the transfer"
                  },
                  "metadata": {
                    "type": "object",
                    "additionalProperties": true,
                    "description": "Additional metadata for the transfer"
                  },
                  "callback_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "URL to receive transfer status updates via webhook"
                  }
                },
                "required": ["transfer_id", "amount", "currency", "country", "channel", "recipient"]
              },
              "example": {
                "transfer_id": "TR-1705234567891",
                "amount": 2500,
                "currency": "XOF",
                "country": "BJ",
                "channel": "mtn_momo",
                "recipient": {
                  "phone_number": "22960000000",
                  "name": "Alice Johnson"
                },
                "description": "Payout for service rendered",
                "metadata": {
                  "payout_reason": "freelance_payment",
                  "contract_id": "CON-789"
                },
                "callback_url": "https://webhook.example.com/transfers"
              }
            }
          }
        },
        "responses": {
          "201": { 
            "description": "Transfer initiated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "transfer_id": { "type": "string" },
                    "status": { "type": "string" },
                    "amount": { "type": "number" },
                    "currency": { "type": "string" },
                    "estimated_completion": { "type": "string", "format": "date-time" },
                    "created_at": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          },
          "400": { "description": "Bad Request" },
          "401": { "description": "Unauthorized - Invalid API Key" },
          "500": { "description": "Server Error" }
        }
      }
    },
